{
  "name": "sizzlr",
  "version": "0.1.0",
  "description": "Turn plans and pull requests into two-voice narrated review videos, rendered locally with no API keys.",
  "keywords": [
    "video",
    "explainer",
    "pull-request",
    "code-review",
    "plan",
    "tts",
    "kokoro",
    "hyperframes",
    "claude-code",
    "codex",
    "agent-skill"
  ],
  "license": "MIT",
  "author": "Sebastian Antosch <write@sebastian-antosch.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santosch/sizzlr.git"
  },
  "homepage": "https://github.com/santosch/sizzlr#readme",
  "bugs": {
    "url": "https://github.com/santosch/sizzlr/issues"
  },
  "type": "module",
  "bin": {
    "sizzlr": "dist/cli.js"
  },
  "files": [
    "dist",
    "styles",
    "assets",
    "runtime",
    "skills",
    "schema",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "geist": "^1.9.2",
    "hyperframes": "^0.9.91",
    "kokoro-js": "^1.2.1",
    "mermaid": "^12.3.0",
    "ts-pattern": "^5.9.2",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.7",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
